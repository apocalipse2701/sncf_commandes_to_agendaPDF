<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- redessiner les widgets après un redémarrage du téléphone -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- mise à jour de l'application : lire la dernière version sur GitHub, la télécharger et l'installer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- (version « mail » : notifications et relevé des commandes ajoutés par src/mail/AndroidManifest.xml) -->

    <application
        android:label="Planning Commandes"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/Theme.Planning">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- « Ouvrir avec » / « Partager » un bulletin PDF depuis une autre appli -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Widget « Planning de la semaine » -->
        <receiver
            android:name=".PlanningWidget"
            android:exported="true"
            android:label="@string/widget_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_semaine" />
        </receiver>
        <!-- Widget « Planning de la semaine (sans horaires) » -->
        <receiver
            android:name=".PlanningWidgetSimple"
            android:exported="true"
            android:label="@string/widget_simple_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_semaine_simple" />
        </receiver>

        <!-- Widget « Planning sur 15 jours » (deux pages) -->
        <receiver
            android:name=".PlanningWidgetQuinzaine"
            android:exported="true"
            android:label="@string/widget_quinzaine_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quinzaine" />
        </receiver>
        <!-- Widget « Planning de la semaine » aux couleurs de GrapheneOS -->
        <receiver
            android:name=".PlanningWidgetGos"
            android:exported="true"
            android:label="@string/widget_nom_gos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_semaine_gos" />
        </receiver>

        <!-- Widget « Planning de la semaine (sans horaires) » aux couleurs de GrapheneOS -->
        <receiver
            android:name=".PlanningWidgetSimpleGos"
            android:exported="true"
            android:label="@string/widget_simple_nom_gos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_semaine_simple_gos" />
        </receiver>

        <!-- Widget « Planning sur 15 jours » aux couleurs de GrapheneOS -->
        <receiver
            android:name=".PlanningWidgetQuinzaineGos"
            android:exported="true"
            android:label="@string/widget_quinzaine_nom_gos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quinzaine_gos" />
        </receiver>
        <!-- Widget « Planning » réglable (le seul proposé dans la liste, avec « Prochain service ») -->
        <receiver
            android:name=".PlanningWidgetReglable"
            android:exported="true"
            android:label="@string/widget_reglable_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_reglable" />
        </receiver>

        <!-- Mini-widget « Prochain service » -->
        <receiver
            android:name=".PlanningWidgetProchain"
            android:exported="true"
            android:label="@string/widget_prochain_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prochain" />
        </receiver>

        <!-- Widget « Calendrier du mois » (style de la page du PDF) -->
        <receiver
            android:name=".PlanningWidgetCalendrier"
            android:exported="true"
            android:label="@string/widget_calendrier_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendrier" />
        </receiver>

        <!-- Réglages d'un widget (à la pose, et appui long → Réglages) -->
        <activity
            android:name=".WidgetReglages"
            android:exported="true"
            android:label="@string/reglages_widget_titre"
            android:theme="@style/Theme.Reglages"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Redémarrage, changement d'heure, mise à jour de l'appli : les widgets se redessinent -->
        <receiver
            android:name=".WidgetReveil"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- réponse d'Android pendant l'installation d'une mise à jour -->
        <receiver
            android:name=".RecepteurInstallation"
            android:exported="false" />
    </application>
</manifest>
