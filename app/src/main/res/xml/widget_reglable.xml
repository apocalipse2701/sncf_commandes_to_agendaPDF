<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Planning » réglable : réglé à la pose (WidgetReglages), s'adapte à sa taille -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="150dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_reglable_orig_h_7"
    android:previewImage="@drawable/widget_apercu"
    android:description="@string/widget_reglable_description"
    android:configure="fr.planning.commandes.WidgetReglages"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
