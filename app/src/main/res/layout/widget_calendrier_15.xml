<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Calendrier », durée « 15 jours » : 2 semaines (2 lignes de poids 390). Fichier produit par un générateur : les poids (millièmes) doivent
     rester ceux de DessinCalendrier (H_TITRE 130, H_ENTETE 56, H_GRILLE 780 = 6 lignes de 130 (mois) ou 2 lignes de 390 (« 15 jours », ce fichier), H_BAS 34 ; MARGE 25, COL 950/7)
     pour que les cases touchables tombent sur les cases dessinées. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_calendrier_nom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="130"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/w_titre_zone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/w_prec"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#5A5A5A"
                android:textSize="26sp"
                android:textStyle="bold"
                android:contentDescription="@string/mois_precedent" />
            <TextView
                android:id="@+id/w_suiv"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#5A5A5A"
                android:textSize="26sp"
                android:textStyle="bold"
                android:contentDescription="@string/mois_suivant" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="56" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="390"
            android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="25" />
            <FrameLayout android:id="@+id/w_c0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="25" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="390"
            android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="25" />
            <FrameLayout android:id="@+id/w_c7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:id="@+id/w_c13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="135.7143" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="25" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="34" />
    </LinearLayout>
</FrameLayout>
